# Environment: development, test, or production
APP_ENV=development
APP_NAME=Paul AI Trader

# Owner account. APP_PASSWORD bootstraps or recovers the original Paul account.
OWNER_USERNAME=paul
APP_PASSWORD=replace-with-a-local-password
SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters
SESSION_COOKIE_NAME=paul_ai_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE_SECONDS=43200

# Family registration. Replace the code in production or disable registration.
REGISTRATION_ENABLED=true
USER_REGISTRATION_CODE=replace-with-a-private-family-code
COMMUNITY_LEARNING_ENABLED=true

# Encrypts each user's optional Bitso API key and secret in PostgreSQL.
# Use a separate long random value. Saved credentials are never displayed again.
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret

# SQLite is suitable for local development. Production must use PostgreSQL.
DATABASE_URL=sqlite:///./paul_ai_trader.db
PAUL_DATA_DIR=./data

BITSO_BASE_URL=https://api.bitso.com/api/v3
# Legacy owner credentials remain supported during migration. New users connect
# their own read-only Bitso credentials from the Account screen.
BITSO_API_KEY=
BITSO_API_SECRET=

# Safety default: real trading remains disabled.
LIVE_TRADING=false
SIMULATED_INITIAL_CAPITAL_MXN=5000
MAX_ORDER_MXN=200
MAX_DAILY_LOSS_MXN=100
MAX_OPEN_ORDERS=3
ALLOWED_BOOKS=btc_mxn,eth_mxn,xrp_mxn,sol_mxn

SYSTEM_HEARTBEAT_SECONDS=60
SYSTEM_RETRY_ATTEMPTS=3
SYSTEM_CIRCUIT_BREAKER_FAILURES=3
SYSTEM_SNAPSHOT_INTERVAL_SECONDS=300
SYSTEM_EVENT_RETENTION=1000

# Starts each enabled paper Runtime when the web application starts or redeploys.
RUNTIME_AUTO_START=true
RUNTIME_LOOP_INTERVAL_SECONDS=5
RUNTIME_BOOKS=btc_mxn
RUNTIME_TIMEFRAME=1m
RUNTIME_STRATEGY=momentum
RUNTIME_TRADE_AMOUNT_MXN=100
RUNTIME_MARKET_DATA_PROVIDER=mock
RUNTIME_BROKER=paper

# Bounded simulation-only experience after long HOLD streaks.
PAPER_EXPLORATION_ENABLED=true
PAPER_EXPLORATION_HOLD_CYCLES=20
PAPER_EXPLORATION_MAX_HOLDING_CYCLES=20
PAPER_EXPLORATION_COOLDOWN_CYCLES=40
PAPER_EXPLORATION_AMOUNT_MXN=10
PAPER_EXPLORATION_MAX_POSITIONS=3

BURNIN_DEFAULT_DURATION=1h
BURNIN_MEMORY_GROWTH_ALERT_BYTES=26214400
BURNIN_MAX_EVENTS=1000
